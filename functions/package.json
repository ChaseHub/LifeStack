{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "lifestack": "file:.."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.1",
    "rimraf": "^6.1.4"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": false
  }
}
